<header>
  <h2>{{bracket.name}}</h2>
</header>
<div class="entrant-stats__heading">
  <h3>Entrant Statistics</h3>
  {{#if entrantStatsExcludesThirdPlace}}
  <i><p class="entrant-stats__note">*Third-place match not included.</p></i>
  {{/if}}
</div>
<div id="reactApp"></div>
<script>
  window._appData = {
    bracket: {{{jsonBlob bracket}}},
    entrants: {{{jsonBlob entrants}}},
  };
</script>
